# Server Configuration
PORT=8080
HOST=0.0.0.0

# Key Vault Configuration
# Azure Key Vault URL or HashiCorp Vault URL
VAULT_URL=https://dp-kv-deliverypilot.vault.azure.net
# Name of secret storing the Xiaomi MiMo API key (default: MIMO_API_KEY)
VAULT_SECRET_NAME=MIMO_API_KEY
# Cache TTL in milliseconds (default: 300000 = 5 minutes)
VAULT_CACHE_TTL_MS=300000

# Azure Key Vault specific (optional if VAULT_URL is provided)
AZURE_KEYVAULT_NAME=dp-kv-deliverypilot

# HashiCorp Vault specific (optional if using HashiCorp Vault)
# VAULT_TYPE=hashicorp
# VAULT_TOKEN=your-vault-token
# VAULT_MOUNT_PATH=secret

# Local Fallback (Used only when Key Vault is not reachable)
# MIMO_API_KEY=local-test-key-only
